{
  "name": "@lyupro/llm-bridge",
  "version": "0.7.0",
  "description": "Claude Code-to-Codex delegation with 8 guards, 6595 tests, zero runtime dependencies, and zero build steps.",
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "subagent",
    "ai-agents",
    "orchestration",
    "hooks"
  ],
  "license": "MIT",
  "author": "Lyu Pro <lyupro.dev@gmail.com> (https://lyupro.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyupro/llm-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/lyupro/llm-bridge/issues"
  },
  "homepage": "https://github.com/lyupro/llm-bridge#readme",
  "type": "module",
  "bin": {
    "llm-bridge": "bin/llm-bridge.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "scripts",
    "!scripts/release-check",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:install": "node bin/llm-bridge.mjs update --force",
    "test": "node scripts/run-tests.mjs",
    "release-check:rules-load-claude": "node scripts/release-check/rules-load-claude.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:open-work": "node scripts/open-work/check.mjs --strict"
  },
  "publishConfig": {
    "access": "public"
  }
}
